{
  "name": "roku-tv-parental-control",
  "version": "1.0.0",
  "private": true,
  "description": "Free parental controls for Roku TV: daily screen time limits, bedtime, app blocking and a phone dashboard. Runs on a Windows PC on your home network.",
  "keywords": [
    "roku",
    "roku-tv",
    "parental-controls",
    "screen-time",
    "screen-time-limit",
    "kids",
    "family",
    "app-blocker",
    "bedtime",
    "ecp",
    "external-control-protocol",
    "windows",
    "self-hosted"
  ],
  "license": "MIT",
  "homepage": "https://github.com/simonry14/roku-tv-parental-control#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/simonry14/roku-tv-parental-control.git"
  },
  "bugs": {
    "url": "https://github.com/simonry14/roku-tv-parental-control/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "dev:mock": "tsx watch --clear-screen=false src/server.ts --config config.mock.json",
    "start": "node dist/src/server.js",
    "build": "npm run clean && tsc -p tsconfig.build.json && npm run build:web",
    "build:web": "vite build --config web/vite.config.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "mock-roku": "tsx mock/mock-roku.ts",
    "setup": "tsx src/cli/index.ts setup",
    "phone": "tsx src/cli/index.ts phone",
    "status": "tsx src/cli/index.ts status",
    "status:mock": "tsx src/cli/index.ts status --config config.mock.json",
    "discover": "tsx src/cli/index.ts discover",
    "sessions": "tsx src/cli/index.ts sessions",
    "apps": "tsx src/cli/index.ts apps",
    "events": "tsx src/cli/index.ts events",
    "pause": "tsx src/cli/index.ts pause",
    "resume": "tsx src/cli/index.ts resume",
    "lock": "tsx src/cli/index.ts lock",
    "unlock": "tsx src/cli/index.ts unlock",
    "bonus": "tsx src/cli/index.ts bonus",
    "set-pin": "tsx src/cli/index.ts set-pin",
    "channel:build": "tsx src/cli/index.ts channel:build",
    "channel:install": "tsx src/cli/index.ts channel:install",
    "message": "tsx src/cli/index.ts message",
    "backup": "tsx src/cli/index.ts backup",
    "service:install": "npm run build && tsx src/cli/service.ts install",
    "service:uninstall": "tsx src/cli/service.ts uninstall",
    "service:start": "tsx src/cli/service.ts start",
    "service:stop": "tsx src/cli/service.ts stop",
    "service:restart": "tsx src/cli/service.ts restart",
    "service:status": "tsx src/cli/service.ts status",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.5",
    "@node-rs/argon2": "^2.2.1",
    "better-sqlite3": "^13.0.3",
    "fast-xml-parser": "^5.11.2",
    "fastify": "^5.12.5",
    "luxon": "^3.7.2",
    "node-windows": "^1.0.0-beta.8",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "qrcode": "^1.5.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/rubik": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/luxon": "^3.7.6",
    "@types/node": "^24.19.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  }
}
