# Secrets and machine-specific overrides. Copy to .env (never commit .env).
# LOG_LEVEL=debug
# ROKU_GUARDIAN_CONFIG=C:\path\to\config.json

# Access token for a protected ntfy topic or your own ntfy server (README §11).
# NTFY_TOKEN=

# The TV's developer-mode password, for npm run channel:install (README §12).
# ROKU_DEV_PASSWORD=
