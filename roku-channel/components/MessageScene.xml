<?xml version="1.0" encoding="utf-8"?>
<!--
  One full-screen message from Roku TV Parental Control. Every word comes from the service (see
  source/main.brs); this component only lays it out, runs the countdown and handles OK/Back.
  1920×1080 (ui_resolutions=fhd), colours from the dashboard's dark theme.
-->
<component name="MessageScene" extends="Scene">
  <interface>
    <!-- { kind, title, body, countdown, countdownText, countdownEnd, dismissable } -->
    <field id="message" type="assocarray" onChange="onMessage" />
    <field id="exitRequested" type="boolean" alwaysNotify="true" />
  </interface>

  <script type="text/brightscript" uri="pkg:/components/MessageScene.brs" />

  <children>
    <Poster id="background" uri="pkg:/images/background.jpg" width="1920" height="1080" />

    <!-- Stacked and vertically centred around y=520 by Layout() in MessageScene.brs. -->
    <Group id="content" translation="[200, 0]">
      <Poster id="icon" width="176" height="176" uri="pkg:/images/info.png" />
      <Label id="title" width="1500" wrap="true" maxLines="2" lineSpacing="0" color="0xEEF1F8FF">
        <Font role="font" uri="pkg:/fonts/Rubik-SemiBold.ttf" size="92" />
      </Label>
      <Label id="body" width="1240" wrap="true" maxLines="4" lineSpacing="10" color="0xA3ABC4FF">
        <Font role="font" uri="pkg:/fonts/Rubik-Regular.ttf" size="46" />
      </Label>
      <Group id="countdown" visible="false">
        <Label id="countdownLabel" width="1240" color="0xEEF1F8FF">
          <Font role="font" uri="pkg:/fonts/Rubik-Medium.ttf" size="42" />
        </Label>
        <Rectangle id="track" translation="[0, 76]" width="1000" height="10" color="0x2B2763FF" />
        <Rectangle id="bar" translation="[0, 76]" width="1000" height="10" color="0xA494FFFF" />
      </Group>
    </Group>

    <Label id="brand" translation="[200, 952]" text="Parental Control" color="0x737C99FF">
      <Font role="font" uri="pkg:/fonts/Rubik-Medium.ttf" size="30" />
    </Label>
    <Label id="hint" translation="[920, 952]" width="800" horizAlign="right" color="0xA3ABC4FF">
      <Font role="font" uri="pkg:/fonts/Rubik-Regular.ttf" size="30" />
    </Label>

    <Timer id="ticker" duration="1" repeat="true" />
    <Animation id="drain" duration="30" easeFunction="linear" repeat="false">
      <FloatFieldInterpolator id="drainWidth" key="[0.0, 1.0]" keyValue="[1000.0, 0.0]" fieldToInterp="bar.width" />
    </Animation>
  </children>
</component>
